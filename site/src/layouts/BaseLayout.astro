---
import '../styles/global.css';
import { SITE, NAV } from '../lib/site.ts';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const brandWords = SITE.brand.split(' ');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" type="application/rss+xml" title={SITE.brand} href="/rss.xml" />

    <!-- Fonts: Rubik (display), Inter (body), DM Mono (labels), Just Me Again Down Here (script) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=Just+Me+Again+Down+Here&family=Rubik:wght@400;500;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- No-flash theme: apply saved/system preference before first paint -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const theme = saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <div class="canvas-bg"></div>

    <header class="site-header">
      <nav>
        <a class="brand" href="/">{brandWords[0]}&nbsp;{brandWords.slice(1).join(' ')}<span class="dot">.</span></a>
        <div class="nav-links">
          {NAV.map((n) => (
            <a href={n.href} aria-current={n.match.test(path) ? 'page' : undefined}>{n.label}</a>
          ))}
        </div>
        <div class="nav-right">
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode">
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <a class="pill-btn" href={SITE.githubUrl} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.8c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
            GitHub
          </a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="fwrap">
        <div>
          <div class="fbrand">{SITE.brand}<span class="dot">.</span></div>
          <p>{SITE.description}</p>
        </div>
        <div class="fcol">
          <h4>Explore</h4>
          <a href="/">Home</a>
          <a href="/blog/">Blog</a>
          <a href="/about/">About</a>
          <a href="/rss.xml">RSS</a>
        </div>
        <div class="fcol">
          <h4>Elsewhere</h4>
          <a href={SITE.githubUrl} target="_blank" rel="noopener">GitHub</a>
          <a href="/rss.xml">Subscribe</a>
        </div>
      </div>
      <div class="fbot">
        <span>© {SITE.brand}</span>
        <span>Built with Astro</span>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const el = document.documentElement;
        const next = el.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        el.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
