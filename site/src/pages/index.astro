---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import { SITE } from '../lib/site.ts';
import { SERIALS, serialOf, STATUS_LABEL } from '../lib/serials.ts';

// Sort across serials by date, not episode number — episode numbers restart per
// serial (Ep 1 of a new serial isn't "older" than Ep 15 of another).
const episodes = (await getCollection('episodes'))
  .filter((e) => e.data.status !== 'draft')
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime() || b.data.episode - a.data.episode);

const latest = episodes.slice(0, 3);
const featured = SERIALS[0];
const featuredCount = episodes.filter((e) => serialOf(e) === featured.slug).length;

// Every other serial gets a smaller secondary card below the featured one.
const others = SERIALS.slice(1).map((serial) => ({
  serial,
  count: episodes.filter((e) => serialOf(e) === serial.slug).length,
}));
const epLabel = (n: number) => `${n} episode${n === 1 ? '' : 's'}`;
---
<BaseLayout title={`${SITE.brand} — ${SITE.tagline}`} description={SITE.description}>
  <div class="wrap">
    <section class="home-hero">
      <p class="hand">{SITE.tagline}</p>
      <h1 class="display">{SITE.brand}<span class="brand-dot"></span></h1>
      <p class="sub"><span class="led"></span> {SITE.description}</p>

      <div class="hero-stickers">
        <span class="sticker cyan">ROS 2</span>
        <span class="sticker amber">ESP32</span>
        <span class="sticker green">Raspberry Pi</span>
        <span class="sticker magenta">Home Assistant</span>
      </div>

      <div class="cta">
        <a class="btn-sticker" href="/blog/">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          Read the blog
        </a>
      </div>
    </section>

    <section>
      <div class="section-head">
        <span class="hand">latest field notes</span>
        <a class="more" href="/blog/">View all →</a>
      </div>
      <div class="grid">
        {latest.map((e) => <EpisodeCard episode={e} />)}
      </div>
    </section>

    <section>
      <div class="section-head">
        <span class="hand">the serials</span>
        <a class="more" href="/blog/">View all →</a>
      </div>
      <div class="grid" style="grid-template-columns:1fr;">
        <a class="card" href={`/serials/${featured.slug}/`} style="max-width:100%;">
          <div class="card__body" style="padding:1.75rem 1.9rem 2rem;gap:0.6rem;">
            <p class="date">{epLabel(featuredCount)} · {STATUS_LABEL[featured.status]}</p>
            <h2 style="margin:0;">{featured.title}</h2>
            <p class="card__teaser" style="font-size:1rem;max-width:44rem;">{featured.blurb}</p>
          </div>
        </a>
      </div>
      {others.length > 0 && (
        <div class="grid" style="margin-top:1rem;">
          {others.map(({ serial, count }) => (
            <a class="card" href={`/serials/${serial.slug}/`}>
              <div class="card__body" style="padding:1.1rem 1.3rem 1.4rem;gap:0.4rem;">
                <p class="date">{epLabel(count)} · {STATUS_LABEL[serial.status]}</p>
                <h3 style="margin:0;">{serial.title}</h3>
                <p class="card__teaser">{serial.tagline}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
