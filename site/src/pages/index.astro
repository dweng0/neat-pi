---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import { SITE } from '../lib/site.ts';
import { SERIALS, serialOf, STATUS_LABEL } from '../lib/serials.ts';

const episodes = (await getCollection('episodes'))
  .filter((e) => e.data.status !== 'draft')
  .sort((a, b) => a.data.episode - b.data.episode);

const latest = [...episodes].reverse().slice(0, 3);
const featured = SERIALS[0];
const featuredCount = episodes.filter((e) => serialOf(e) === featured.slug).length;
---
<BaseLayout title={`${SITE.brand} — ${SITE.tagline}`} description={SITE.description}>
  <div class="wrap">
    <section class="home-hero">
      <p class="hand">{SITE.tagline}</p>
      <h1 class="display">{SITE.brand}<span class="brand-dot"></span></h1>
      <p class="sub"><span class="led"></span> {SITE.description}</p>

      <div class="hero-stickers">
        <span class="sticker cyan">ROS 2</span>
        <span class="sticker amber">ESP32</span>
        <span class="sticker green">Raspberry Pi</span>
        <span class="sticker magenta">Home Assistant</span>
      </div>

      <div class="cta">
        <a class="btn-sticker" href="/blog/">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          Read the blog
        </a>
      </div>
    </section>

    <section>
      <div class="section-head">
        <span class="hand">latest field notes</span>
        <a class="more" href="/blog/">View all →</a>
      </div>
      <div class="grid">
        {latest.map((e) => <EpisodeCard episode={e} />)}
      </div>
    </section>

    <section>
      <div class="section-head">
        <span class="hand">the serial</span>
        <a class="more" href={`/serials/${featured.slug}/`}>Open →</a>
      </div>
      <div class="grid" style="grid-template-columns:1fr;">
        <a class="card" href={`/serials/${featured.slug}/`} style="max-width:100%;">
          <div class="card__body" style="padding:1.75rem 1.9rem 2rem;gap:0.6rem;">
            <p class="date">{featuredCount} episodes · {STATUS_LABEL[featured.status]}</p>
            <h2 style="margin:0;">{featured.title}</h2>
            <p class="card__teaser" style="font-size:1rem;max-width:44rem;">{featured.blurb}</p>
          </div>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
