---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import { refKind, refTitle, refOrder } from '../../lib/reference.ts';
import { SERIALS, serialOf, getSerial, STATUS_LABEL } from '../../lib/serials.ts';
import { getPhoto } from '../../lib/photos.ts';

export async function getStaticPaths() {
  return SERIALS.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const serial = getSerial(slug!)!;

const episodes = (await getCollection('episodes'))
  .filter((e) => e.data.status !== 'draft' && serialOf(e) === serial.slug)
  .sort((a, b) => b.data.episode - a.data.episode);

const latest = episodes[0];
const heroName = latest?.data.heroPhoto ?? serial.coverPhoto;
const hero = getPhoto(heroName);

const refs = (await getCollection('reference')).sort((a, b) => refOrder(a.id) - refOrder(b.id));
---
<BaseLayout title={`${serial.title} — ${'Housekeeper Systems'}`} description={serial.blurb}>
  <div class="wrap">
    <p class="crumb"><a href="/blog/">Blog</a> <span class="sep">/</span> {serial.title}</p>

    <section class="page-head" style="text-align:left;padding:1rem 0 2.5rem;">
      <p class="hand">the serial</p>
      <h1>{serial.title}</h1>
      <p class="lede" style="margin-left:0;">{serial.blurb}</p>
      <div class="hero-stickers" style="justify-content:flex-start;margin-top:1.5rem;">
        <span class="sticker cyan">{episodes.length} episodes</span>
        <span class={`sticker ${serial.status === 'ongoing' ? 'amber' : 'green'}`}>{STATUS_LABEL[serial.status]}</span>
      </div>
    </section>

    {hero && (
      <Image class="hero" src={hero} alt={serial.title} widths={[600, 1000, 1400]} sizes="(max-width: 72rem) 100vw, 72rem" />
    )}

    <div class="section-head"><span class="hand">episodes</span></div>
    <div class="grid">
      {episodes.map((e) => <EpisodeCard episode={e} />)}
    </div>

    <div class="section-head"><span class="hand">reference</span></div>
    <p class="lede" style="margin:0 0 1.5rem;">The living docs — always current, unlike the episodes (which are snapshots in time).</p>
    <div class="grid" style="padding-bottom:5rem;">
      {refs.map((r) => (
        <a href={`/reference/${r.id}/`} class="card">
          <div class="card__body" style="gap:0.7rem;">
            <span class={`badge ${refKind(r.id)}`}>{refKind(r.id)}</span>
            <h3 class="card__title">{refTitle(r.id, r.body)}</h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
