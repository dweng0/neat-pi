---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { refTitle, refKind } from '../../lib/reference.ts';

export async function getStaticPaths() {
  const refs = await getCollection('reference');
  return refs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = refTitle(entry.id, entry.body);
const kind = refKind(entry.id);
---
<BaseLayout title={`${title} — Housekeeper Systems Reference`}>
  <div class="wrap">
    <article class="article">
      <p class="crumb"><a href="/blog/">Blog</a> <span class="sep">/</span> Reference</p>
      <p class="hand">reference</p>
      <h1>{title}</h1>
      <p class="meta-line">
        <span class={`badge ${kind}`}>{kind}</span>
        <span class="dot">·</span> Living document — the current source of truth. Episodes are snapshots; this stays current.
      </p>
      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>
