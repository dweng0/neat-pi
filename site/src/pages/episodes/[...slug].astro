---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import { serialOf, getSerial } from '../../lib/serials.ts';
import { getPhoto } from '../../lib/photos.ts';

export async function getStaticPaths() {
  const all = (await getCollection('episodes')).sort((a, b) => a.data.episode - b.data.episode);
  return all.map((entry) => {
    // prev/next stay within the same serial so navigation doesn't jump between build stories.
    const siblings = all.filter((e) => serialOf(e) === serialOf(entry));
    const i = siblings.findIndex((e) => e.id === entry.id);
    const prev = siblings[i - 1];
    const next = siblings[i + 1];
    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: prev && { slug: prev.id, title: prev.data.title, episode: prev.data.episode },
        next: next && { slug: next.id, title: next.data.title, episode: next.data.episode },
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const serial = getSerial(serialOf(entry));
const hero = getPhoto(d.heroPhoto);

const fmt = (date?: Date) =>
  date ? date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
---
<BaseLayout title={`Ep. ${d.episode}: ${d.title} — ${serial?.title ?? 'Housekeeper Systems'}`} description={d.teaser}>
  <div class="wrap">
    <article class="article">
      {serial && (
        <p class="crumb">
          <a href="/blog/">Blog</a> <span class="sep">/</span>
          <a href={`/serials/${serial.slug}/`}>{serial.title}</a> <span class="sep">/</span> Ep. {d.episode}
        </p>
      )}
      <p class="hand">episode {d.episode}</p>
      <h1>{d.title}</h1>
      <p class="meta-line">
        Published {fmt(d.pubDate)}
        {d.sessionDate && <><span class="dot">·</span> bench session {fmt(d.sessionDate)}</>}
      </p>

      {hero && <Image class="hero" src={hero} alt={d.title} widths={[600, 1000, 1400]} sizes="(max-width: 44rem) 100vw, 44rem" />}

      <div class="prose">
        <Content />
      </div>

      <SeriesNav prev={prev} next={next} />
    </article>
  </div>
</BaseLayout>
